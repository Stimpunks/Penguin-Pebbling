# Netlify response headers.
#
# Hand-maintained: no tool generates this file, and an edit here stays put.
# One tool reads it. tools/make-service-worker.py hashes these bytes into sw.js's
# version, because a browser decides whether to install a new worker by comparing
# the script byte for byte and the response headers are not part of that
# comparison — so **re-run it after editing here**, or a policy change reaches new
# visitors and nobody who already has the worker. That is written up at length in
# that tool, and it cost a deploy to learn.

/*
  # HTML and other documents revalidate every time. The page is small; being
  # current matters more than saving a round trip.
  #
  # No `stale-if-error` alongside `must-revalidate` — RFC 9111 forbids serving a
  # stale must-revalidate response, so the two cancel.
  Cache-Control: public, max-age=0, must-revalidate

  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

  # Netlify's "Force HTTPS" setting already sends HSTS, but only
  # `max-age=31536000` with no `includeSubDomains`. Setting it here overrides
  # that with the two-year policy RFC 6797 and OWASP ask for, and keeps it
  # reviewable in a diff like every other header rather than living only in a
  # dashboard. No `preload`: the preload list's own operator now advises against
  # it, browsers auto-upgrade HTTP navigations anyway, and removal takes months.
  Strict-Transport-Security: max-age=63072000; includeSubDomains

  # Four registered relations, on every response rather than only on the front
  # page, because an agent can arrive anywhere and a header reaches one that
  # never parses HTML at all. llms.txt v2 in particular is found by relation
  # rather than by guessing the path, and the feed is found the same way by a
  # reader handed a bare URL. All four are IANA-registered — inventing a rel
  # gets it ignored.
  #
  # The relations are written here by hand; the files they point at are generated
  # elsewhere — llms.txt by tools/make-llms-txt.py, feed.xml by
  # tools/build-changelog.py. Adding a relation and shipping the file it names are
  # two edits, not one.
  Link: </llms.txt>; rel="describedby"; type="text/markdown", </sitemap.xml>; rel="sitemap"; type="application/xml", <https://creativecommons.org/licenses/by-nc-sa/4.0/>; rel="license", </feed.xml>; rel="alternate"; type="application/rss+xml"

  # Every one of these is a feature this site does not use and will never use.
  # An empty allowlist turns it off outright, so an injected script cannot reach
  # the camera or the location even if one ever got past the CSP — and it says
  # in the response, without anyone having to take our word for it, that a page
  # about Autistic identity is not asking where you are.
  #
  # Deliberately only features the browsers actually recognise: an unknown name
  # earns a console warning, and "the console is clean" is a thing worth being
  # able to check here.
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), usb=(), xr-spatial-tracking=()

  # Nothing here needs framing, and the game carries an attribution requirement.
  # Framing it inside someone else's chrome is how the credit gets lost.
  X-Frame-Options: DENY

  # No inline script and no external origin is needed at all: the page loads one
  # local stylesheet and two local scripts, and every image, font and PDF is
  # local.
  # `img-src` allows data: because nothing uses it today and it costs nothing to
  # keep an inline SVG working if one is ever added.
  # Two directives exist here only because of the service worker, and both are
  # `'self'` — our own script, our own origin, nothing else loosened.
  #
  # `worker-src` falls back through `child-src` to `default-src`, so
  # `default-src 'none'` refused to register the worker at all.
  #
  # `connect-src` falls back straight to `default-src`, and it governs `fetch()`
  # — including the fetches a service worker makes inside `cache.add()`. Without
  # it the worker registers, activates, controls the page, and caches precisely
  # nothing: every precache entry fails and offline silently does not exist. It
  # shipped that way for one deploy. The local preview sends no CSP at all, so
  # there is nothing to catch this before production — the only check is the live
  # site, which is why the verification is in the commit rather than assumed.
  Content-Security-Policy: default-src 'none'; script-src 'self'; worker-src 'self'; connect-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# Card art changes only when Helen redraws a card, but the filenames are stable
# — `infodumping-locution.webp` says nothing about its contents the way a content
# hash would. So `immutable` for a year was a promise this site cannot keep: the
# documented way to replace a card is to drop a new original into cards/print/
# at the same filename and re-run tools/make-images.py, which leaves every
# returning reader holding the old picture with nothing to invalidate it.
#
# This now covers the five locution cards on locutions.html and the five cut-out
# illustrations in cards/art/. The thirty prompt-card derivatives that used to
# live here were retired with the re-set.
#
# A week, revalidating in the background. Long enough that a reader on a metered
# connection is not refetching 50 KB of artwork each visit, short enough that a
# correction actually reaches people. The fonts below keep the year because
# their names really are versioned.
/cards/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/downloads/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Font files never change without changing name — the filename carries the
# subset and style — and a missing font is the most visible possible regression
# on a page whose typeface is an accessibility choice. These get the long cache
# the card art no longer does.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The stylesheet and the script revalidate with the HTML, and deliberately do
# NOT get the long cache the images and fonts do.
#
# There is no build step here, so these have stable names rather than
# content-hashed ones. That means the page and its stylesheet are versioned
# together only by whatever each reader happens to hold. With max-age=3600 plus
# stale-while-revalidate=86400 a returning reader could be served today's HTML
# against a stylesheet up to a day old — and the two have to agree about class
# names and DOM shape. Observed on the typography change: the live page kept
# rendering at the old sizes in a browser whose CSS copy had not expired.
#
# 16 KB and 12 KB. A conditional request that usually answers 304 is cheaper
# than a page that renders wrong for a day, so correctness wins the round trip.
/penguin-pebbling.css
  Cache-Control: public, max-age=0, must-revalidate

/penguin-pebbling.js
  Cache-Control: public, max-age=0, must-revalidate

/theme.js
  Cache-Control: public, max-age=0, must-revalidate

# The service worker decides what every other request does, so it is the one file
# that must never be served stale: a held sw.js is a site that cannot be updated.
# Browsers cap its lifetime at 24 hours regardless; this says nothing is held.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# Generated from penguin-pebbling.js, so it revalidates with it. This is what our
# own site mirror reads to get the deck's text — see tools/make-search-index.py.
/search-index.json
  Cache-Control: public, max-age=0, must-revalidate

# Served as markdown to match the type advertised in the Link header above, and
# revalidated like the pages it indexes: a stale llms.txt teaches a model the
# wrong things confidently, which is worse than not shipping one.
/llms.txt
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

# The changelog's RSS feed, generated from CHANGELOG.md by
# tools/build-changelog.py alongside changelog.html.
#
# Netlify would serve a .xml as application/xml, which most readers will accept
# once they already believe it is a feed. The registered type is what tells the
# ones that check — a browser extension, or a reader handed the site's bare
# address — that this is a feed at all rather than some XML.
#
# Revalidated like the pages it mirrors. A feed is a notification, and a held
# one is a notification that does not arrive.
/feed.xml
  Content-Type: application/rss+xml; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate
